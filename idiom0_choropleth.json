{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 600,
  "title": {
    "text": "The Urban Footprint: Human Population vs. Wildlife Sightings",
    "subtitle": "Background shading represents LGA population; dots represent citizen science observations.",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 10
  },
  "projection": {
    "type": "mercator",
    "scale": 4500,
    "center": [145, -36.5]
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/deldersveld/topojson/master/countries/australia/au-victorian-local-government-areas.json",
        "format": {"type": "json", "property": "VMLITE_LGA_URBAN_REGION"}
      },
      "transform": [
        {
          "lookup": "properties.lga_name",
          "from": {
            "data": {"url": "data/vic_lga_population.csv"},
            "key": "Unnamed: 1",
            "fields": ["2025"]
          }
        }
      ],
      "mark": {
        "type": "geoshape", 
        "stroke": "#ffffff", 
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "2025",
          "type": "quantitative",
          "scale": {"scheme": "blues"},
          "title": "Human Population"
        },
        "tooltip": [
          {"field": "properties.LGA_NAME11", "type": "nominal", "title": "Council (LGA)"},
          {"field": "2025", "type": "quantitative", "format": ",", "title": "2025 Population"}
        ]
      }
    },
    {
      "data": {
        "url": "data/garden_sunskink.csv"
      },
      "transform": [
        {"calculate": "'Garden Sunskink'", "as": "species"}
      ],
      "mark": {
        "type": "circle", 
        "size": 25, 
        "opacity": 0.8, 
        "color": "#d95f02"
      },
      "encoding": {
        "longitude": {"field": "decimalLongitude", "type": "quantitative"},
        "latitude": {"field": "decimalLatitude", "type": "quantitative"},
        "tooltip": [
          {"field": "species", "type": "nominal", "title": "Species Sighted"},
          {"field": "month", "type": "ordinal", "title": "Month"},
          {"field": "year", "type": "ordinal", "title": "Year"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"}
  }
}