{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Urban Sprawl Gradient by Wildlife Species",
    "subtitle": "Sighting density by distance from capital CBD (km)",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "data": {"url": "data/sightings.csv"},
  "params": [
    {
      "name": "state_select",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "ACT"],
        "labels": [
          "All Australia",
          "New South Wales (Sydney)",
          "Victoria (Melbourne)",
          "Queensland (Brisbane)",
          "South Australia (Adelaide)",
          "Western Australia (Perth)",
          "Tasmania (Hobart)",
          "ACT (Canberra)"
        ],
        "name": "Filter Capital Region: "
      }
    }
  ],
  "transform": [
    {"filter": "state_select == 'All' || datum.state_abbr == state_select"},
    {"calculate": "toNumber(datum.km_cbd)", "as": "dist"},
    {"filter": "datum.dist <= 80"},
    {
      "density": "dist",
      "groupby": ["species", "group"],
      "extent": [0, 80],
      "steps": 80
    }
  ],
  "facet": {
    "row": {
      "field": "species",
      "type": "nominal",
      "sort": [
        "Indian Myna",
        "Grey-headed Flying-fox",
        "Rainbow Lorikeet",
        "Noisy Miner",
        "Common Brushtail Possum",
        "Australian Magpie",
        "Common Blackbird",
        "Garden Sunskink",
        "Australian King-Parrot"
      ],
      "title": null,
      "header": {
        "labelAngle": 0,
        "labelAlign": "left",
        "labelFontSize": 11,
        "labelFontWeight": "bold"
      }
    }
  },
  "spec": {
    "width": 360,
    "height": 34,
    "mark": {
      "type": "area",
      "interpolate": "monotone",
      "fillOpacity": 0.78,
      "stroke": "#1e293b",
      "strokeWidth": 1.2
    },
    "encoding": {
      "x": {
        "field": "value",
        "type": "quantitative",
        "title": "Distance from Capital CBD (km)",
        "scale": {"domain": [0, 80]}
      },
      "y": {
        "field": "density",
        "type": "quantitative",
        "axis": null,
        "scale": {"range": [34, 2]}
      },
      "color": {
        "field": "group",
        "type": "nominal",
        "title": "Ecological Group",
        "scale": {
          "domain": ["Native bird", "Invasive bird", "Mammal", "Reptile"],
          "range": ["#0284c7", "#dc2626", "#7c3aed", "#d97706"]
        }
      },
      "tooltip": [
        {"field": "species", "type": "nominal", "title": "Species"},
        {"field": "group", "type": "nominal", "title": "Group"},
        {"field": "value", "type": "quantitative", "title": "Distance from CBD (km)", "format": ".1f"},
        {"field": "density", "type": "quantitative", "title": "Relative Density", "format": ".4f"}
      ]
    }
  },
  "resolve": {
    "scale": {"y": "independent"}
  },
  "bounds": "flush",
  "spacing": 6,
  "config": {
    "view": {"stroke": "transparent"},
    "axisX": {"grid": true, "gridOpacity": 0.3}
  }
}