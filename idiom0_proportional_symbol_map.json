{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "National Biodiversity Hotspots Across Australia",
    "subtitle": "Circle size shows total citizen science sightings; colour reveals species richness per ~50km zone",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 540,
  "height": 450,
  "background": "#f8fafc",
  "projection": {
    "type": "mercator",
    "center": [133.5, -28.0],
    "scale": 700
  },
  "params": [
    {
      "name": "min_species",
      "value": 2,
      "bind": {"input": "range", "min": 1, "max": 9, "step": 1, "name": "Min Species: "}
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/australian-states-fixed.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {"url": "data/sightings.csv"},
      "transform": [
        {"calculate": "round(datum.lat * 2) / 2", "as": "lat_zone"},
        {"calculate": "round(datum.lon * 2) / 2", "as": "lon_zone"},
        {
          "aggregate": [
            {"op": "count", "as": "total_sightings"},
            {"op": "distinct", "field": "species", "as": "species_richness"}
          ],
          "groupby": ["lat_zone", "lon_zone", "state_abbr"]
        },
        {"filter": "datum.total_sightings >= 10"},
        {"filter": "datum.species_richness >= min_species"}
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "stroke": "#0f172a",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {"field": "lon_zone", "type": "quantitative"},
        "latitude": {"field": "lat_zone", "type": "quantitative"},
        "size": {
          "field": "total_sightings",
          "type": "quantitative",
          "title": "Total Sightings",
          "scale": {"type": "sqrt", "range": [15, 1200]}
        },
        "color": {
          "field": "species_richness",
          "type": "ordinal",
          "title": "Species Richness",
          "scale": {"scheme": "viridis"}
        },
        "tooltip": [
          {"field": "state_abbr", "type": "nominal", "title": "State"},
          {"field": "species_richness", "type": "quantitative", "title": "Coexisting Target Species"},
          {"field": "total_sightings", "type": "quantitative", "title": "Total Sightings", "format": ","}
        ]
      }
    }
  ],
  "config": {"view": {"stroke": "transparent"}}
}