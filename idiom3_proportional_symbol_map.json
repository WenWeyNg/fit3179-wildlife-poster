{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Proportional Symbol Map: Wildlife Observation Volume Across Victoria",
    "subtitle": "Circle size is directly proportional to total sightings; colour shows species richness per ~20km zone",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 700,
  "height": 450,
  "background": "#f8fafc",
  "projection": {
    "type": "mercator",
    "center": [145.4, -36.6],
    "scale": 4200
  },
  "params": [
    {
      "name": "min_sightings",
      "value": 20,
      "bind": {
        "input": "range",
        "min": 5,
        "max": 200,
        "step": 5,
        "name": "Minimum Sightings in Zone: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/LGA_2025_AUST_GDA2020.json",
        "format": {"type": "json", "property": "geometries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#94a3b8",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {"url": "data/sightings.csv"},
      "transform": [
        {"calculate": "round(datum.lat * 5) / 5", "as": "lat_zone"},
        {"calculate": "round(datum.lon * 5) / 5", "as": "lon_zone"},
        {
          "aggregate": [
            {"op": "count", "as": "total_sightings"},
            {"op": "distinct", "field": "species", "as": "species_richness"},
            {"op": "mean", "field": "km_cbd", "as": "avg_km_cbd"}
          ],
          "groupby": ["lat_zone", "lon_zone"]
        },
        {"filter": "datum.total_sightings >= min_sightings"}
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#0f172a",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {"field": "lon_zone", "type": "quantitative"},
        "latitude": {"field": "lat_zone", "type": "quantitative"},
        "size": {
          "field": "total_sightings",
          "type": "quantitative",
          "title": "Total Sightings",
          "scale": {"type": "sqrt", "range": [30, 1400]}
        },
        "color": {
          "field": "species_richness",
          "type": "quantitative",
          "title": "Species Count",
          "scale": {"scheme": "viridis"}
        },
        "tooltip": [
          {"field": "total_sightings", "type": "quantitative", "title": "Total Sightings", "format": ","},
          {"field": "species_richness", "type": "quantitative", "title": "Unique Species Present"},
          {"field": "avg_km_cbd", "type": "quantitative", "title": "Distance to CBD (km)", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {"view": {"stroke": "transparent"}}
}